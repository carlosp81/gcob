# CLN Connection
CLN_NODE_URI=https://127.0.0.1:50062
CLN_HOSTNAME=debian-knots

# Server
GRPC_BIND_ADDR=0.0.0.0:50063

# TLS (CLN_CERT_DIR defaults to the admin account's ~/.certs)
# CLN_CERT_DIR=/home/<admin>/.certs
CLN_CA_FILE=ca.pem
CLN_CLIENT_FILE=client.pem
CLN_CLIENT_KEY_FILE=client-key.pem
SERVER_CERT_FILE=server.pem
SERVER_KEY_FILE=server-key.pem

# Environment (production enables the gcob user check on startup)
GCOB_ENV=production

# Host role: server enables serve/sign/certs renew; client denies them.
GCOB_ROLE=server
